# Google Maps (via conector Lovable)
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Cron / webhooks
CRON_SECRET=

# Pagamentos
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
ASAAS_WEBHOOK_TOKEN=
