# APOIS CORRIDAS — painel administrativo — modelo de ambiente.
# Copie para ambiente local ou configure no provedor de deploy.
# NUNCA versione valores reais, tokens privados ou credenciais server-side.

VITE_APP_ROLE=web

# Supabase APOIS CORRIDAS
SUPABASE_PROJECT_ID=<APOIS_CORRIDAS_PROJECT_REF>
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
SUPABASE_URL=https://<APOIS_CORRIDAS_PROJECT_REF>.supabase.co

VITE_SUPABASE_PROJECT_ID=<APOIS_CORRIDAS_PROJECT_REF>
VITE_SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
VITE_SUPABASE_URL=https://<APOIS_CORRIDAS_PROJECT_REF>.supabase.co

# Google Maps browser key deve ser configurada no provedor e restrita por domínio/API.
VITE_APOIS_GOOGLE_MAPS_BROWSER_KEY=<GOOGLE_MAPS_BROWSER_KEY>
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=<OPTIONAL_TRACKING_ID>

# Server-side only
CRON_SECRET=<SERVER_ONLY_SECRET>
MERCADOPAGO_ACCESS_TOKEN=<SERVER_ONLY_SECRET>
MERCADOPAGO_WEBHOOK_SECRET=<SERVER_ONLY_SECRET>
ASAAS_API_KEY=<SERVER_ONLY_SECRET>
ASAAS_WEBHOOK_TOKEN=<SERVER_ONLY_SECRET>
FIREBASE_SERVICE_ACCOUNT_JSON=<SERVER_ONLY_SECRET>
