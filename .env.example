# MOVVI — Variáveis de ambiente (modelo).
# Copie este arquivo para `.env` e preencha localmente.
# NUNCA commite `.env` com valores reais.

# Papel do build (separação dos apps).
# - "web"                     → padrão. Site + admin + fallback (comportamento atual).
# - "passenger" / "passageiro" → build do app MOVVI Passageiro (Play Store).
# - "driver"    / "motorista"  → build do app MOVVI Motorista (Play Store).
VITE_APP_ROLE=web


# Supabase / Lovable Cloud
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Google Maps (via conector Lovable)
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=

# Cron / webhooks
CRON_SECRET=

# Pagamentos
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
ASAAS_WEBHOOK_TOKEN=
